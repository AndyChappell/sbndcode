#include "analysisConfig.fcl"
#include "simulationservices_sbnd.fcl"

process_name: PandoraValidation

source:
{
    module_type: RootInput
    maxEvents: -1
}

services:
{
    TFileService: { fileName: "analysisOutput.root" }
    @table::sbnd_services
}

physics:
{
    analyzers:
    {
        ana: @local::pandoraValidation
    }

    path0: [ ana ]
    end_paths: [ path0 ]
}
